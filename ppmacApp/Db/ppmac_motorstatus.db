######## MACROS ###########
# SYS:	PV system name - same as for motor record
# DEV:	PV device name - same as for motor record
# PORT: asyn port name to the PMAC (for instance PMAC_S0)
# AXIS: PMAC axis number to request the status word for

# physical motor axis limit update
record(calc, "$(SYS)$(DEV)-HLS") {
  field(SCAN, ".2 second")
  field(CALC, "(A>>3&1)+B")
  field(INPA, "$(SYS)$(DEV)Sts:1-Sts") # PMAC status positive limit
  field(INPB, "$(SYS)$(DEV)Mtr.HLS") # motor record positive limit
}

record(calc, "$(SYS)$(DEV)-LLS") {
  field(SCAN, ".2 second")
  field(CALC, "(A>>2&1)+B")
  field(INPA, "$(SYS)$(DEV)Sts:1-Sts") # PMAC status negative limit
  field(INPB, "$(SYS)$(DEV)Mtr.LLS") # motor record negative limit
}

