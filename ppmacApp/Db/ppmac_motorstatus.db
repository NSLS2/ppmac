  field(DESC, "actual motor current readback")
  field(DTYP, "asynFloat64")
  field(INP, "@asyn($(PORT),0)PMAC_VDF_Motor[$(AXIS)].IdMeas")
  field(SCAN, "I/O Intr")
  field(PREC, "1")
  field(EGU, "mA")
  alias("$(SYSC)$(DEVC)Cur-I")
}

